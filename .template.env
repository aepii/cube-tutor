# Hosts
POSTGRES_HOST=postgres

# Port numbers
POSTGRES_HOST_PORT=5433
POSTGRES_CONTAINER_PORT=5432
REDIS_HOST_PORT=6380   
PGADMIN_HOST_PORT=5050
BACKEND_HOST_PORT=8000

# Postgres authentication
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_CONTAINER_PORT}/${POSTGRES_DB}

# pgAdmin authentication
PGADMIN_EMAIL=your_email@example.com
PGADMIN_PASSWORD=your_pg_admin_password

# JWT
SECRET_KEY=your_secret

# Backend app (see docs/backend.md#configuration). docker-compose.yml falls back to these dev values if unset.
# Browser origins allowed by CORS: comma-separated or a JSON list. Expo web runs on :8081.
CORS_ORIGINS=http://localhost:8081,http://localhost:8080
# Log every SQL statement (noisy)
SQL_ECHO=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1


# Backend tests (optional). Default: built from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_HOST_PORT
# on localhost, database cubetutor_test. The database name must end in _test.
# TEST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_HOST_PORT}/cubetutor_test
